 bool NativeLayerRootCA::CommitToScreen() {
+#ifdef MOZ_WIDGET_UIKIT
+  // Take mLayerUpdateMutex first and mMutex second, matching
+  // NativeLayerRootRemoteMacParent::RecvCommitNativeLayerCommands, which
+  // holds mLayerUpdateMutex while SetOnscreenCommitData takes mMutex.
+  // Reversing that order here would let the two paths deadlock.
+  ReleasableMutexAutoLock layerUpdateLock(mLayerUpdateMutex);
+
+  if (!NS_IsMainThread()) {
+    // Committing off the main thread makes CoreAnimation lay out the host
+    // UIKit view on the Compositor thread. When that host view is a
+    // UIScrollView/UICollectionView (keyboard or password autofill UI),
+    // Auto Layout asserts _AssertAutoLayoutOnAllowedThreadsOnly and the
+    // process aborts, so never let an off-main-thread commit get that far.
+    //
+    // AutoCATransaction must not exist yet: it commits the surrounding
+    // transaction in its destructor, so returning after constructing it
+    // would still flush a transaction on this thread. That is exactly why
+    // the previous revision of this patch did not fix the crash.
+    //
+    // mMainThreadCommitCallback is installed by widget/uikit/nsWindow right
+    // after CreateForCALayer and cleared during teardown, so check it at
+    // runtime: MOZ_ASSERT compiles out under --enable-release and calling
+    // an empty std::function throws std::bad_function_call, which would
+    // terminate the process just like the assertion this avoids.
+    MutexAutoLock lock(mMutex);
+    if (mMainThreadCommitCallback) {
+      if (!mMainThreadCommitScheduled) {
+        mMainThreadCommitScheduled = true;
+        mMainThreadCommitCallback();
+      }
+    } else {
+      mMainThreadCommitScheduled = false;
+    }
+    return false;
+  }
+
+  AutoCATransaction transaction;
+#endif
+
+  MutexAutoLock lock(mMutex);
+
+#ifdef MOZ_WIDGET_UIKIT
+  mMainThreadCommitScheduled = false;
+#endif
+
   if (!NS_IsMainThread() && mOffMainThreadCommitsSuspended) {
     mCommitPending = true;
     return false;
   }
 
